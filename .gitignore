# Entirely exclude training data
training_data/

# Include necessary files and folders within src
# (Everything in src/ is included by default unless a broader ignore rule matches it)
# We can use a whitelist-like approach to be very clear if preferred, 
# but a clean standard ignore list is usually better.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db